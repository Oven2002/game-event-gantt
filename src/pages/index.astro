---
import "lxgw-wenkai-lite-webfont/lxgwwenkailite-regular.css";
import "../styles/global.css";
import { Image } from "astro:assets";
import { loadTimelineData } from "../lib/data";
import heroImage from "../assets/timeline-hero.png";

const payload = loadTimelineData();
const games = [...new Map(payload.groups.map((group) => [group.game.id, group.game])).values()];
const regions = [...new Map(payload.groups.map((group) => [group.region.id, group.region])).values()];
const serialized = JSON.stringify(payload).replaceAll("<", "\\u003c");
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconUrl = `${baseUrl}favicon.png`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="二游版本与活动时间表，使用北京时间展示版本、活动与直播日程。" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <link rel="stylesheet" href={`${baseUrl}vendor/live2d-widget/dist/waifu.css`} />
    <link rel="stylesheet" href={`${baseUrl}vendor/mascot.css`} />
    <title>二游版本活动时间表</title>
  </head>
  <body>
    <canvas id="sakura-canvas" class="sakura-canvas" aria-hidden="true"></canvas>
    <header class="topbar">
      <nav class="topbar__inner" aria-label="主导航">
        <a class="topbar__brand" href={baseUrl}>
          <img class="topbar__mark" src={faviconUrl} width="32" height="32" alt="" />
          <span>二游时间表</span>
        </a>
        <div class="topbar__links">
          <button class="effect-toggle" type="button" data-effect-toggle aria-pressed="true" title="关闭樱花特效"><i aria-hidden="true">✦</i><span>特效开</span></button>
          <a href="https://github.com/Oven2002/game-event-gantt/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">贡献数据</a>
          <a href="https://github.com/Oven2002/game-event-gantt" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </nav>
    </header>

    <section class="hero" aria-labelledby="page-title">
      <Image
        class="hero__art"
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 760px) 100vw, 1480px"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__content">
        <div class="hero__eyebrow">COMMUNITY TIMELINE</div>
        <h1 id="page-title">二游版本活动时间表</h1>
        <p>把版本、卡池、活动和前瞻放到同一条北京时间轴上。</p>
        <div class="hero__legend" aria-label="图例">
          <span><i class="legend-swatch legend-swatch--version"></i>版本</span>
          <span><i class="legend-swatch legend-swatch--event"></i>区间活动</span>
          <span><i class="legend-point"></i>单点事件</span>
          <span><i class="legend-now"></i>现在</span>
        </div>
      </div>
    </section>

    <main>
      <section class="toolbar" aria-label="时间表控制栏">
        <div class="filters">
          <details class="filter-menu">
            <summary>游戏 <span data-filter-count="game"></span></summary>
            <fieldset data-filter="game">
              <legend class="sr-only">筛选游戏</legend>
              {games.map((game) => (
                <label><input type="checkbox" value={game.id} checked /> {game.name}</label>
              ))}
            </fieldset>
          </details>

          <details class="filter-menu">
            <summary>服务器 <span data-filter-count="region"></span></summary>
            <fieldset data-filter="region">
              <legend class="sr-only">筛选服务器</legend>
              {regions.map((region) => (
                <label><input type="checkbox" value={region.id} checked /> {region.name}</label>
              ))}
            </fieldset>
          </details>

          <details class="filter-menu">
            <summary>活动类型 <span data-filter-count="type"></span></summary>
            <fieldset data-filter="type">
              <legend class="sr-only">筛选活动类型</legend>
              {payload.eventTypes.map((type) => (
                <label><input type="checkbox" value={type.id} checked /> {type.name}</label>
              ))}
            </fieldset>
          </details>

          <details class="filter-menu">
            <summary>状态 <span data-filter-count="status"></span></summary>
            <fieldset data-filter="status">
              <legend class="sr-only">筛选状态</legend>
              <label><input type="checkbox" value="ongoing" checked /> 进行中</label>
              <label><input type="checkbox" value="upcoming" checked /> 即将开始</label>
              <label><input type="checkbox" value="ended" /> 已结束</label>
            </fieldset>
          </details>
        </div>

        <div class="time-controls" aria-label="时间轴控制">
          <button type="button" data-action="zoom-out" aria-label="缩小时间轴">−</button>
          <button type="button" data-action="zoom-in" aria-label="放大时间轴">＋</button>
          <button type="button" data-action="today">今天</button>
        </div>
      </section>

      <div class="timezone-note"><span></span>所有日期与时间均为北京时间（UTC+8）</div>
      <section id="timeline" class="timeline" aria-label="游戏版本与活动甘特图"></section>
      <section id="empty-state" class="empty-state" hidden>
        <strong>没有符合条件的条目哦～</strong>
        <p>调整游戏、服务器、类型或状态筛选后再试。</p>
      </section>
    </main>

    <dialog id="detail-dialog" class="detail-dialog" aria-labelledby="detail-title">
      <button class="detail-dialog__close" type="button" data-close-detail aria-label="关闭详情">×</button>
      <div id="detail-content"></div>
    </dialog>

    <footer>
      <div class="thanks" aria-label="鸣谢">
        <span>Thanks</span>
        <ul>
          <li>
            <a href="https://openai.com/" target="_blank" rel="noopener noreferrer">
              <svg class="thanks__icon" viewBox="130 210 300 300" aria-hidden="true">
                <path d="M249.176 323.434V298.276C249.176 296.158 249.971 294.569 251.825 293.509L302.406 264.381C309.29 260.409 317.5 258.555 325.973 258.555C357.75 258.555 377.877 283.185 377.877 309.399C377.877 311.253 377.877 313.371 377.611 315.49L325.178 284.771C322.001 282.919 318.822 282.919 315.645 284.771L249.176 323.434ZM367.283 421.415V361.301C367.283 357.592 365.694 354.945 362.516 353.092L296.048 314.43L317.763 301.982C319.617 300.925 321.206 300.925 323.058 301.982L373.639 331.112C388.205 339.586 398.003 357.592 398.003 375.069C398.003 395.195 386.087 413.733 367.283 421.412V421.415ZM233.553 368.452L211.838 355.742C209.986 354.684 209.19 353.095 209.19 350.975V292.718C209.19 264.383 230.905 242.932 260.301 242.932C271.423 242.932 281.748 246.641 290.49 253.26L238.321 283.449C235.146 285.303 233.555 287.951 233.555 291.659V368.455L233.553 368.452ZM280.292 395.462L249.176 377.985V340.913L280.292 323.436L311.407 340.913V377.985L280.292 395.462ZM300.286 475.968C289.163 475.968 278.837 472.259 270.097 465.64L322.264 435.449C325.441 433.597 327.03 430.949 327.03 427.239V350.445L349.011 363.155C350.865 364.213 351.66 365.802 351.66 367.922V426.179C351.66 454.514 329.679 475.965 300.286 475.965V475.968ZM237.525 416.915L186.944 387.785C172.378 379.31 162.582 361.305 162.582 343.827C162.582 323.436 174.763 305.164 193.563 297.485V357.861C193.563 361.571 195.154 364.217 198.33 366.071L264.535 404.467L242.82 416.915C240.967 417.972 239.377 417.972 237.525 416.915ZM234.614 460.343C204.689 460.343 182.71 437.833 182.71 410.028C182.71 407.91 182.976 405.792 183.238 403.672L235.405 433.863C238.582 435.715 241.763 435.715 244.938 433.863L311.407 395.466V420.622C311.407 422.742 310.612 424.331 308.758 425.389L258.179 454.519C251.293 458.491 243.083 460.343 234.611 460.343H234.614ZM300.286 491.854C332.329 491.854 359.073 469.082 365.167 438.892C394.825 431.211 413.892 403.406 413.892 375.073C413.892 356.535 405.948 338.529 391.648 325.552C392.972 319.991 393.766 314.43 393.766 308.87C393.766 271.003 363.048 242.666 327.562 242.666C320.413 242.666 313.528 243.723 306.644 246.109C294.725 234.457 278.307 227.042 260.301 227.042C228.258 227.042 201.513 249.815 195.42 280.004C165.761 287.685 146.694 315.49 146.694 343.824C146.694 362.362 154.638 380.368 168.938 393.344C167.613 398.906 166.819 404.467 166.819 410.027C166.819 447.894 197.538 476.231 233.024 476.231C240.172 476.231 247.058 475.173 253.943 472.788C265.859 484.441 282.278 491.854 300.286 491.854Z" />
              </svg>
              OpenAI
            </a>
          </li>
          <li>
            <a href="https://www.deepseek.com/" target="_blank" rel="noopener noreferrer">
              <svg class="thanks__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.748 4.651c-.254-.124-.364.113-.512.233-.051.04-.094.09-.137.137-.372.397-.806.657-1.373.626-.829-.046-1.537.214-2.163.848-.133-.782-.575-1.248-1.247-1.548-.352-.155-.708-.311-.955-.65-.172-.24-.219-.509-.305-.774-.055-.16-.11-.323-.293-.35-.2-.031-.278.136-.356.276-.313.572-.434 1.202-.422 1.84.027 1.436.633 2.58 1.838 3.393.137.094.172.187.129.323-.082.28-.18.553-.266.833-.055.179-.137.218-.328.14a5.5 5.5 0 0 1-1.737-1.179c-.857-.828-1.631-1.743-2.597-2.46a12 12 0 0 0-.689-.47c-.985-.957.13-1.743.387-1.836.27-.098.094-.433-.778-.428-.872.003-1.67.295-2.687.685a3 3 0 0 1-.465.136 9.6 9.6 0 0 0-2.883-.101c-1.885.21-3.39 1.1-4.497 2.622C.082 8.776-.231 10.854.152 13.02c.403 2.284 1.568 4.175 3.36 5.653 1.857 1.533 3.997 2.284 6.438 2.14 1.482-.085 3.132-.284 4.994-1.86.47.234.962.328 1.78.398.629.058 1.235-.031 1.705-.129.735-.155.684-.836.418-.961-2.155-1.004-1.682-.595-2.112-.926 1.095-1.295 2.768-3.598 3.284-6.733.05-.346.115-.834.108-1.114-.004-.171.035-.238.23-.257a4.2 4.2 0 0 0 1.545-.475c1.397-.763 1.96-2.016 2.093-3.517.02-.23-.004-.467-.247-.588M11.58 18.168c-2.088-1.642-3.101-2.183-3.52-2.16-.39.024-.32.472-.234.763.09.288.207.487.371.74.114.167.192.416-.113.603-.673.416-1.842-.14-1.897-.168-1.361-.801-2.5-1.86-3.301-3.306-.775-1.393-1.225-2.888-1.299-4.482-.02-.385.094-.522.477-.592a4.7 4.7 0 0 1 1.53-.038c2.131.311 3.946 1.264 5.467 2.774.868.86 1.525 1.887 2.202 2.89.72 1.066 1.494 2.082 2.48 2.915.348.291.626.513.892.677-.802.09-2.14.109-3.055-.615zm1.001-6.44a.306.306 0 0 1 .415-.287.3.3 0 0 1 .113.074.3.3 0 0 1 .086.214c0 .17-.136.307-.308.307a.303.303 0 0 1-.306-.307m3.11 1.596c-.2.081-.4.151-.591.16a1.25 1.25 0 0 1-.798-.254c-.274-.23-.47-.358-.551-.758a1.7 1.7 0 0 1 .015-.588c.07-.327-.007-.537-.238-.727-.188-.156-.426-.199-.689-.199a.6.6 0 0 1-.254-.078.253.253 0 0 1-.114-.358 1 1 0 0 1 .192-.21c.356-.202.767-.136 1.146.016.352.144.618.408 1.001.782.392.451.462.576.685.915.176.264.336.536.446.848.066.194-.02.353-.25.45" />
              </svg>
              DeepSeek
            </a>
          </li>
        </ul>
      </div>
      <p>数据由社区维护 · 时间仅供参考，请以游戏官方公告为准</p>
      <p class="made-with">Made with <span aria-label="爱">♥</span> by 二游社区</p>
      <p class="live2d-notice">This content uses sample data owned and copyrighted by Live2D Inc. The sample data are utilized in accordance with terms and conditions set by Live2D Inc. This content itself is created at the author's sole discretion. · <a href="https://github.com/Oven2002/game-event-gantt/blob/main/THIRD_PARTY_NOTICES.md" target="_blank" rel="noopener noreferrer">第三方许可</a></p>
    </footer>

    <script id="timeline-data" type="application/json" set:html={serialized} is:inline></script>
    <script>
      import "../scripts/timeline";
      import "../scripts/effects";
      import "../scripts/mascot";
    </script>
  </body>
</html>
